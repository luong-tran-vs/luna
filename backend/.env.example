# Local development settings for `go run ./cmd/server` (run from the backend directory).
# Copy to backend/.env; that file is ignored by git. Real environment variables win over it.

# Database: mongo (default) or mysql. Only the settings of the chosen one are read.
# mysql needs a MySQL 8.0.19+ server with the database below already created; tables are created on startup.
DB_DRIVER=mongo

# MySQL (used only when DB_DRIVER=mysql). The password is a secret: only in backend/.env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=luna
MYSQL_PASSWORD=
MYSQL_DATABASE=luna
# A full DSN (user:password@tcp(host:3306)/database) replaces the five settings above when set.
# MYSQL_DSN=
# Connection pool and timeouts; the values shown are the defaults (leave commented to keep them).
# MYSQL_MAX_OPEN_CONNS=20
# MYSQL_MAX_IDLE_CONNS=5
# MYSQL_CONN_MAX_LIFETIME=5m
# MYSQL_DIAL_TIMEOUT=2s

MONGO_URI=mongodb+srv://tranhuuluong156200_db_user:I1m4oFqKre49MqfB@luna.soxft5v.mongodb.net/?appName=luna

MONGO_DATABASE=luna
HTTP_ADDR=:8080
LOG_LEVEL=debug
COOKIE_SECURE=false
# Web origins allowed to call the API from a browser (comma-separated), or * for any origin.
# Leave empty when the frontend is served from the same origin.
CORS_ORIGINS=*

TTS_URL=http://localhost:8880
TTS_VOICE=af_heart
AUDIO_DIR=./data/audio
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Model that draws the vocabulary pictures (F23); paid per picture, used only when an admin turns pictures on.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Offline dictionary: run deploy/fetch-dictionary.sh (or .ps1) first
DICTIONARY_PATH=../deploy/data/dictionary/dictionary.db
