# Local development settings for `go run ./cmd/api` (run from the backend directory).
# Copy to backend/.env; that file is ignored by git. Real environment variables win over it.
# Docker Compose does not use this file (see deploy/.env.example).

# MongoDB started with: docker compose -f deploy/docker-compose.yml up -d mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=luna
HTTP_ADDR=:8080
LOG_LEVEL=debug
COOKIE_SECURE=false

# Text-to-speech (Kokoro). Start it with: docker compose -f deploy/docker-compose.yml up -d kokoro
TTS_URL=http://localhost:8880
TTS_VOICE=af_heart
AUDIO_DIR=./data/audio

# Lesson annotations: gemini or none. Free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Offline dictionary: run deploy/fetch-dictionary.sh (or .ps1) first
DICTIONARY_PATH=../deploy/data/dictionary/dictionary.db
