# Copy to deploy/.env to override the defaults in docker-compose.yml.
# deploy/.env is ignored by git: never commit real secrets.

# MongoDB connection string used by the backend container.
MONGO_URI=mongodb://mongo:27017

# Backend log level: debug | info | warn | error
LOG_LEVEL=info

# Port on this machine where the app is served (http://localhost:8000).
WEB_PORT=8000

# MongoDB database name used by the backend.
MONGO_DATABASE=luna

# Add the Secure flag to the session cookie: true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Lesson annotations: gemini or none. Free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# Secret: set it only in deploy/.env (ignored by git).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Daily database backup (service "backup"): time of day, its timezone and how many copies to keep.
# Backups go to deploy/backups/; see "Sao lưu và khôi phục" in README.md.
BACKUP_TZ=Asia/Ho_Chi_Minh
BACKUP_TIME=03:00
BACKUP_KEEP=7
