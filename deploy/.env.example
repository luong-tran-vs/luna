# Copy to deploy/.env to override the defaults in docker-compose.yml.
# deploy/.env is ignored by git: never commit real secrets.

# Database the backend uses: mongo (default) or mysql. Only the settings of the chosen one are read.
# mysql also needs the "mysql" compose profile: docker compose -f docker-compose.yml --profile mysql up --build.
DB_DRIVER=mongo

# MySQL (used only when DB_DRIVER=mysql). These also set up the "mysql" compose service, which creates
# this user and database on its first start. The password is a secret: set your own, only in deploy/.env.
# Inside compose the host is the service name "mysql"; the user cannot be root.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=luna
MYSQL_PASSWORD=
MYSQL_DATABASE=luna
# A full DSN (user:password@tcp(host:3306)/database) replaces the five settings above when set.
# MYSQL_DSN=
# Connection pool and timeouts; the values shown are the defaults (leave commented to keep them).
# MYSQL_MAX_OPEN_CONNS=20
# MYSQL_MAX_IDLE_CONNS=5
# MYSQL_CONN_MAX_LIFETIME=5m
# MYSQL_DIAL_TIMEOUT=2s

# MongoDB connection string used by the backend container.
MONGO_URI=mongodb://mongo:27017

# Backend log level: debug | info | warn | error
LOG_LEVEL=info

# Port on this machine where the app is served (http://localhost:8000).
WEB_PORT=8000

# MongoDB database name used by the backend.
MONGO_DATABASE=luna

# Add the Secure flag to the session cookie: true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Lesson annotations: gemini or none. Free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# Secret: set it only in deploy/.env (ignored by git).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Daily database backup (service "backup"): time of day, its timezone and how many copies to keep.
# Backups go to deploy/backups/; see "Sao lưu và khôi phục" in README.md.
BACKUP_TZ=Asia/Ho_Chi_Minh
BACKUP_TIME=03:00
BACKUP_KEEP=7
